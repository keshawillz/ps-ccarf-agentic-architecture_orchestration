{
  "name": "CCAR-F: Agentic Architecture & Orchestration",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "postCreateCommand": "pip install -r requirements.txt && npm install -g @anthropic-ai/claude-code",
  "secrets": {
    "ANTHROPIC_API_KEY": {
      "description": "Your Anthropic API key. Every demo and challenge reads it from the environment."
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
